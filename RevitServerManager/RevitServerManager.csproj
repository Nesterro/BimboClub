<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>icon_server.ico</ApplicationIcon>
    <AssemblyName>RevitServerManager</AssemblyName>
    <RootNamespace>RevitServerManager</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <None Include="icon_server.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <ProjectReference Include="..\RevitServerBridge\RevitServerBridge.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>
  <!-- Evaluate the payload only after the project reference has been built. -->
  <Target Name="IncludeBridgePayload" BeforeTargets="AssignTargetPaths" DependsOnTargets="ResolveProjectReferences">
    <MSBuild Projects="..\RevitServerBridge\RevitServerBridge.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_BridgeTarget" />
    </MSBuild>
    <PropertyGroup>
      <_BridgeDirectory>@(_BridgeTarget->'%(RootDir)%(Directory)')</_BridgeDirectory>
    </PropertyGroup>
    <Error Condition="!Exists('$(_BridgeDirectory)RSBridge.exe')" Text="Revit Server bridge payload is missing." />
    <ItemGroup>
      <_BridgePayload Include="$(_BridgeDirectory)RSBridge.exe;$(_BridgeDirectory)*.dll" />
      <EmbeddedResource Remove="@(_BridgePayload)" />
      <EmbeddedResource Include="@(_BridgePayload)">
        <Link>Bridge\%(_BridgePayload.Filename)%(_BridgePayload.Extension)</Link>
        <LogicalName>RevitServerManager.Bridge.%(_BridgePayload.Filename)%(_BridgePayload.Extension)</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>
</Project>
