<Application x:Class="RevitServerManagerInstaller.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Colors -->
        <SolidColorBrush x:Key="BgDarkBrush" Color="#19191E" />
        <SolidColorBrush x:Key="PanelDarkBrush" Color="#24242B" />
        <SolidColorBrush x:Key="ControlDarkBrush" Color="#2D2D36" />
        <SolidColorBrush x:Key="BorderDarkBrush" Color="#41414D" />
        <SolidColorBrush x:Key="TextWhiteBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#AAA6B5" />
        <SolidColorBrush x:Key="AccentScarletBrush" Color="#9D4D66" />
        <SolidColorBrush x:Key="AccentScarletHoverBrush" Color="#AE5D76" />
        <SolidColorBrush x:Key="AccentScarletActiveBrush" Color="#C17E96" />
        <SolidColorBrush x:Key="SuccessGreenBrush" Color="#10B981" />
    </Application.Resources>
</Application>
