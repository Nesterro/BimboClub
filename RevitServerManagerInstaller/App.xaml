<Application x:Class="RevitServerManagerInstaller.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Colors -->
        <SolidColorBrush x:Key="BgDarkBrush" Color="#141418" />
        <SolidColorBrush x:Key="PanelDarkBrush" Color="#1C1C22" />
        <SolidColorBrush x:Key="ControlDarkBrush" Color="#282832" />
        <SolidColorBrush x:Key="BorderDarkBrush" Color="#3A3A46" />
        <SolidColorBrush x:Key="TextWhiteBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#A5A5B5" />
        <SolidColorBrush x:Key="AccentScarletBrush" Color="#B30E2D" />
        <SolidColorBrush x:Key="AccentScarletHoverBrush" Color="#E0113A" />
        <SolidColorBrush x:Key="AccentScarletActiveBrush" Color="#FF2E5B" />
        <SolidColorBrush x:Key="SuccessGreenBrush" Color="#10B981" />
    </Application.Resources>
</Application>
