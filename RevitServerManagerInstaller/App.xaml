<Application x:Class="RevitServerManagerInstaller.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Colors -->
        <SolidColorBrush x:Key="BgDarkBrush" Color="#262626" />
        <SolidColorBrush x:Key="PanelDarkBrush" Color="#2F2F2F" />
        <SolidColorBrush x:Key="ControlDarkBrush" Color="#383838" />
        <SolidColorBrush x:Key="BorderDarkBrush" Color="#484848" />
        <SolidColorBrush x:Key="TextWhiteBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#BBBBBB" />
        <SolidColorBrush x:Key="AccentScarletBrush" Color="#0078D4" />
        <SolidColorBrush x:Key="AccentScarletHoverBrush" Color="#1E8CE1" />
        <SolidColorBrush x:Key="AccentScarletActiveBrush" Color="#0078D4" />
        <SolidColorBrush x:Key="SuccessGreenBrush" Color="#10B981" />
    </Application.Resources>
</Application>
