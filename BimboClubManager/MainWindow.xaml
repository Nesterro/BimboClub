<Window x:Class="BimboClubManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:BimboClubManager.ViewModels"
        xmlns:models="clr-namespace:BimboClubManager.Models"
        mc:Ignorable="d"
        Title="BimboClub Tools — Менеджер обновлений" 
        Icon="icon_manager.png"
        Height="720" Width="1160"
        Style="{StaticResource ModernWindowStyle}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Border CornerRadius="12" Background="{StaticResource BackgroundBrush}" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Title Bar -->
                <RowDefinition Height="45" />
                <!-- Main Content -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Border Grid.Row="0" Background="#080611" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Application Title & Icon -->
                    <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Image Source="icon_manager.png" Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Text="BimboClub Tools" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        <Border Margin="8,0,0,0" Padding="6,2" CornerRadius="4" Background="#1D153E" VerticalAlignment="Center">
                            <TextBlock Text="Менеджер обновлений" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                        </Border>
                    </StackPanel>

                    <!-- Windows Window Controls -->
                    <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Button Width="30" Height="30" Content="—" Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}" BorderThickness="0" Cursor="Hand" Click="MinimizeButton_Click" Margin="0,0,4,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="btnBorder" Background="Transparent" CornerRadius="15">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="btnBorder" Property="Background" Value="#1C1835" />
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Width="30" Height="30" Content="✕" Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}" BorderThickness="0" Cursor="Hand" Click="CloseButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="btnBorder" Background="Transparent" CornerRadius="15">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource DangerBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Application Body -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <!-- Sidebar Navigation -->
                    <ColumnDefinition Width="200" />
                    <!-- Tab Panel Content -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0" Background="{StaticResource SidebarBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Menu Items -->
                        <StackPanel Grid.Row="0" Margin="0,20,0,0">
                            <!-- Plugins Tab Toggle Button -->
                            <RadioButton Style="{StaticResource SidebarButtonStyle}" 
                                         GroupName="SidebarMenu" 
                                         IsChecked="{Binding IsPluginsTabActive, Mode=OneWay}"
                                         Command="{Binding NavigateCommand}" 
                                         CommandParameter="plugins">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M0,0 L12,0 L12,4 L0,4 Z M0,6 L12,6 L12,10 L0,10 Z M0,12 L12,12 L12,16 L0,16 Z" 
                                          Fill="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" 
                                          Width="14" Height="14" Margin="0,0,12,0" Stretch="Fill" />
                                    <TextBlock Text="Плагины" FontWeight="SemiBold" FontSize="14" />
                                </StackPanel>
                            </RadioButton>

                            <!-- Settings Tab Toggle Button -->
                            <RadioButton Style="{StaticResource SidebarButtonStyle}" 
                                         GroupName="SidebarMenu" 
                                         IsChecked="{Binding IsSettingsTabActive, Mode=OneWay}"
                                         Command="{Binding NavigateCommand}" 
                                         CommandParameter="settings">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M10,0 C12,0 14,2 14,4 C14,6 12,8 10,8 C8,8 6,6 6,4 C6,2 8,0 10,0 Z M10,12 C14,12 18,15 18,18 L18,20 L2,20 L2,18 C2,15 6,12 10,12 Z" 
                                          Fill="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" 
                                          Width="14" Height="14" Margin="0,0,12,0" Stretch="Fill" />
                                    <TextBlock Text="Настройки" FontWeight="SemiBold" FontSize="14" />
                                </StackPanel>
                            </RadioButton>

                            <!-- About Tab Toggle Button -->
                            <RadioButton Style="{StaticResource SidebarButtonStyle}" 
                                         GroupName="SidebarMenu" 
                                         IsChecked="{Binding IsAboutTabActive, Mode=OneWay}"
                                         Command="{Binding NavigateCommand}" 
                                         CommandParameter="about">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M10,20 C4.5,20 0,15.5 0,10 C0,4.5 4.5,0 10,0 C15.5,0 20,4.5 20,10 C20,15.5 15.5,20 10,20 Z M9,5 L9,7 L11,7 L11,5 L9,5 Z M9,9 L9,15 L11,15 L11,9 L9,9 Z" 
                                          Fill="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" 
                                          Width="14" Height="14" Margin="0,0,12,0" Stretch="Fill" />
                                    <TextBlock Text="О программе" FontWeight="SemiBold" FontSize="14" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <!-- Sidebar Footer Info -->
                        <StackPanel Grid.Row="1" Margin="16,0,16,16" Opacity="0.5">
                            <TextBlock Text="BimboClub Client" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding ClientVersion}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Page Content Area -->
                <Grid Grid.Column="1" Margin="24">
                    
                    <!-- TAB 1: PLUGINS -->
                    <Grid x:Name="PluginsTab">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentTab}" Value="plugins">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.55*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Column: Revit Version Status Cards -->
                        <Grid Grid.Column="0" Margin="0,0,16,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Установленные версии Revit" Style="{StaticResource HeadingStyle}" Margin="0,0,0,16" Grid.Row="0" />

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                                <ItemsControl ItemsSource="{Binding RevitVersions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:RevitVersionInfo}">
                                            <Border Style="{StaticResource CardStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Revit Icon Badge -->
                                                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="10" Margin="0,0,14,0" VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#251E3D" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsRevitInstalled}" Value="False">
                                                                        <Setter Property="Background" Value="#171220" />
                                                                        <Setter Property="Opacity" Value="0.4" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsUpdateAvailable}" Value="True">
                                                                        <Setter Property="Background" Value="#3D291E" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        
                                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock Text="R" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsRevitInstalled}" Value="False">
                                                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsUpdateAvailable}" Value="True">
                                                                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding Year}" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,-2,0,0" />
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Details -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="15" TextWrapping="Wrap">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsRevitInstalled}" Value="False">
                                                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        
                                                        <!-- Version Badges (Installed vs Available) -->
                                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,3">
                                                            <!-- Installed Version Badge -->
                                                            <Border CornerRadius="4" Background="#1C1835" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="6,2" Margin="0,0,8,0">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="Установлена: " FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                                                    <TextBlock Text="{Binding InstalledVersionDisplay}" FontSize="11" FontWeight="Bold">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsPluginInstalled}" Value="False">
                                                                                        <Setter Property="Foreground" Value="#756D8D" />
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding IsRevitInstalled}" Value="False">
                                                                                        <Setter Property="Foreground" Value="#554E69" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                            </Border>

                                                            <!-- Available Version Badge -->
                                                            <Border CornerRadius="4" Background="#1C1835" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="6,2">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="Доступна: " FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                                                    <TextBlock Text="{Binding AvailableVersionDisplay}" FontSize="11" FontWeight="Bold">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsUpdateAvailable}" Value="True">
                                                                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding IsAvailableVersionUpToDate}" Value="True">
                                                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>

                                                        <!-- Status subtext -->
                                                        <TextBlock Text="{Binding StatusDescription}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsUpdateAvailable}" Value="True">
                                                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsPluginInstalled}" Value="True">
                                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsRevitInstalled}" Value="False">
                                                                            <Setter Property="Foreground" Value="#5C566E" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <!-- Action buttons -->
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        
                                                        <!-- Install Button -->
                                                        <Button Content="Установить" 
                                                                Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" 
                                                                Height="32" FontSize="12" Padding="14,0">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding IsRevitInstalled}" Value="True" />
                                                                                <Condition Binding="{Binding IsPluginInstalled}" Value="False" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>

                                                        <!-- Update Button -->
                                                        <Button Content="Обновить" 
                                                                Background="{StaticResource WarningGradientBrush}"
                                                                Foreground="#121020" FontWeight="Bold"
                                                                Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" 
                                                                Height="32" FontSize="12" Padding="14,0" Margin="0,0,6,0">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding IsRevitInstalled}" Value="True" />
                                                                                <Condition Binding="{Binding IsUpdateAvailable}" Value="True" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>

                                                        <!-- Reinstall / Delete Buttons when already installed & updated -->
                                                        <Button Content="Переустановить" 
                                                                Command="{Binding DataContext.ReinstallCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" 
                                                                Height="32" FontSize="11" Padding="10,0" Margin="0,0,6,0">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource OutlineButtonStyle}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding IsRevitInstalled}" Value="True" />
                                                                                <Condition Binding="{Binding IsPluginInstalled}" Value="True" />
                                                                                <Condition Binding="{Binding IsUpdateAvailable}" Value="False" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>

                                                        <!-- Delete Button -->
                                                        <Button Content="Удалить" 
                                                                Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" 
                                                                Height="32" FontSize="11" Padding="10,0">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource DangerButtonStyle}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding IsRevitInstalled}" Value="True" />
                                                                                <Condition Binding="{Binding IsPluginInstalled}" Value="True" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>

                                                        <!-- Not installed placeholder label -->
                                                        <TextBlock Text="—" 
                                                                   Foreground="#3A344E" 
                                                                   FontWeight="Bold" 
                                                                   VerticalAlignment="Center" 
                                                                   Margin="10,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsRevitInstalled}" Value="False">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <!-- Right Column: Update center & logs -->
                        <Grid Grid.Column="1" Margin="8,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Центр обновлений" Style="{StaticResource HeadingStyle}" Margin="0,0,0,16" Grid.Row="0" />

                            <Border Style="{StaticResource CardStyle}" Grid.Row="1" VerticalAlignment="Stretch">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Latest version header -->
                                    <StackPanel Grid.Row="0">
                                        <TextBlock Text="ПОСЛЕДНЯЯ ДОСТУПНАЯ ВЕРСИЯ" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding LatestReleaseVersion, FallbackValue='Загрузка...'}" 
                                                   FontSize="32" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,4,0,12" />

                                        <!-- Update All Button if updates are available -->
                                        <Button Content="{Binding UpdateAllButtonText}"
                                                Command="{Binding UpdateAllCommand}"
                                                Background="{StaticResource WarningGradientBrush}"
                                                Foreground="#121020" FontWeight="Bold"
                                                Height="38" FontSize="13" Margin="0,0,0,14">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasUpdatesAvailable}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,14" />
                                    </StackPanel>

                                    <!-- Changelog section -->
                                    <Grid Grid.Row="1">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="СПИСОК ИЗМЕНЕНИЙ" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" Grid.Row="0" />
                                        
                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                            <StackPanel>
                                                <TextBlock Text="{Binding LatestReleaseName}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding LatestReleaseBody}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="12" LineHeight="18" />
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Check for Updates Action Button -->
                            <Button Content="Проверить обновления" 
                                    Command="{Binding CheckForUpdatesCommand}"
                                    Style="{StaticResource ModernButtonStyle}" 
                                    Height="44" FontSize="14"
                                    Grid.Row="2" Margin="0,16,0,0" />
                        </Grid>
                    </Grid>

                    <!-- TAB 2: SETTINGS -->
                    <Grid x:Name="SettingsTab">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentTab}" Value="settings">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <StackPanel MaxWidth="600" HorizontalAlignment="Left">
                            <TextBlock Text="Настройки обновлений" Style="{StaticResource HeadingStyle}" Margin="0,0,0,8" />
                            <TextBlock Text="Параметры источника релизов и автопроверки" Style="{StaticResource SubheadingStyle}" Margin="0,0,0,24" />

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="РЕПОЗИТОРИЙ GITHUB" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12" />
                                    
                                    <TextBlock Text="Источник манифеста обновлений:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                    <TextBox Text="{Binding GitHubRepo, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,16" />

                                    <CheckBox Content="Автоматически проверять обновления при запуске" 
                                              IsChecked="{Binding AutoCheckUpdates}" 
                                              Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,8" />
                                    
                                    <CheckBox Content="Включить предварительные сборки (Pre-release)" 
                                              IsChecked="{Binding IncludePreReleases}" 
                                              Style="{StaticResource ModernCheckBoxStyle}" />
                                </StackPanel>
                            </Border>

                            <Button Content="Сохранить настройки" 
                                    Command="{Binding SaveSettingsCommand}"
                                    Style="{StaticResource ModernButtonStyle}" 
                                    HorizontalAlignment="Left" Width="200" Margin="0,16,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- TAB 3: ABOUT -->
                    <Grid x:Name="AboutTab">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentTab}" Value="about">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <StackPanel MaxWidth="600" HorizontalAlignment="Left">
                            <Border Width="80" Height="80" CornerRadius="18" HorizontalAlignment="Left" Margin="0,0,0,16">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FFF0F5" Offset="0"/>
                                        <GradientStop Color="#F8C8D8" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <TextBlock Text="BC" FontSize="36" FontWeight="Bold" Foreground="#D81B60" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe UI Black"/>
                                </Grid>
                            </Border>

                            <TextBlock Text="BimboClub Tools Client" Style="{StaticResource HeadingStyle}" Margin="0,0,0,4" />
                            <TextBlock Text="Универсальный менеджер установки и обновления плагинов Revit" Style="{StaticResource SubheadingStyle}" Margin="0,0,0,24" />

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <TextBlock Text="Версия клиента:" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding ClientVersion}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,12" />
                                    <Grid Margin="0,0,0,12">
                                        <TextBlock Text="Разработчик:" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="BimboClub Team" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,12" />
                                    <Grid>
                                        <TextBlock Text="Платформа:" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text=".NET 8.0 WPF (Standalone)" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" HorizontalAlignment="Right" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                    
                </Grid>
            </Grid>

            <!-- ============================================================ -->
            <!-- MODAL OVERLAY 1: REVIT RUNNING WARNING WITH SYNC ADVICE      -->
            <!-- ============================================================ -->
            <Grid Grid.RowSpan="2" Background="#D9080611" 
                  Visibility="{Binding ShowRevitWarning, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Width="560" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="#16112C" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1.5"
                        CornerRadius="16" Padding="28">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="6" Opacity="0.7" />
                    </Border.Effect>

                    <StackPanel>
                        <!-- Header with Warning Icon -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Width="40" Height="40" CornerRadius="20" Background="#3D291E" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="⚠️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Autodesk Revit запущен!" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Требуется освободить файлы плагина" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Explanatory text -->
                        <TextBlock Text="Для установки или обновления плагина необходимо закрыть запущенный процесс Revit, иначе файлы библиотек заблокированы операционной системой."
                                   FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,16" />

                        <!-- High priority alert box: Save & Sync instructions -->
                        <Border Background="#2B151F" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="🔴 ВНИМАНИЕ: СИНХРОНИЗИРУЙТЕ ПРОЕКТ!" FontWeight="Bold" FontSize="12" Foreground="{StaticResource DangerBrush}" Margin="0,0,0,6" />
                                <TextBlock Text="Перед закрытием обязательно сохраните работу и выполните синхронизацию с хранилищем:&#x0a;«Совместная работа» → «Синхронизировать с хранилищем» (Sync with Central). Не закрывайте Revit без сохранения!"
                                           FontSize="12" Foreground="#F5D0D6" TextWrapping="Wrap" LineHeight="18" />
                            </StackPanel>
                        </Border>

                        <!-- Dynamic warning message (if user clicked re-check and Revit is still open) -->
                        <TextBlock Text="{Binding RevitWarningStatus}" Foreground="{StaticResource WarningBrush}" 
                                   FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14" />

                        <!-- Action Buttons -->
                        <StackPanel Margin="0,8,0,0">
                            <!-- Button 1: Re-check if closed -->
                            <Button Content="✓ Я сохранил и закрыл Revit — продолжить" 
                                    Command="{Binding CheckRevitClosedCommand}"
                                    Style="{StaticResource ModernButtonStyle}" 
                                    Height="40" FontSize="13" Margin="0,0,0,8" />

                            <!-- Button 2: Gracefully request Revit to close (triggers Revit's Save/Sync dialog) -->
                            <Button Content="Закрыть Revit корректно (с сохранением)" 
                                    Command="{Binding GracefulCloseRevitCommand}"
                                    Style="{StaticResource OutlineButtonStyle}" 
                                    Height="36" FontSize="12" Margin="0,0,0,8" />

                            <!-- Button 3: Cancel -->
                            <Button Content="Отмена" 
                                    Command="{Binding CloseWarningCommand}"
                                    Style="{StaticResource OutlineButtonStyle}" 
                                    Height="36" FontSize="12" Margin="0,0,0,12" />

                            <!-- Force Kill Link -->
                            <Button Content="Принудительно завершить процесс Revit (Kill)" 
                                    Command="{Binding ForceKillRevitCommand}"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="{StaticResource DangerBrush}" FontSize="11" 
                                    Cursor="Hand" HorizontalAlignment="Center" Opacity="0.75" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============================================================ -->
            <!-- MODAL OVERLAY 2: LOADING & PROGRESS INDICATOR                -->
            <!-- ============================================================ -->
            <Grid Grid.RowSpan="2" Background="#B0080611"
                  Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Width="380" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="#17122E" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="14" Padding="24">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="25" ShadowDepth="4" Opacity="0.5" />
                    </Border.Effect>

                    <StackPanel HorizontalAlignment="Center" Width="330">
                        <TextBlock Text="{Binding ProgressText, FallbackValue='Пожалуйста, подождите...'}" 
                                   Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="14" 
                                   TextAlignment="Center" Margin="0,0,0,14" TextWrapping="Wrap" />

                        <ProgressBar Value="{Binding GlobalProgress}" Minimum="0" Maximum="100" Height="8" 
                                     Foreground="{StaticResource AccentBrush}" Background="#251E3D" BorderThickness="0" Margin="0,0,0,8" />

                        <TextBlock Text="{Binding GlobalProgress, StringFormat='{}{0:F0}%'}" 
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" 
                                   HorizontalAlignment="Right" />
                    </StackPanel>
                </Border>
            </Grid>

        </Grid>
    </Border>
</Window>
