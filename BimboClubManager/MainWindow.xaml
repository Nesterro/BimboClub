<Window x:Class="BimboClubManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:BimboClubManager.ViewModels"
        xmlns:models="clr-namespace:BimboClubManager.Models"
        mc:Ignorable="d"
        Title="Панель BimboClub" 
        Height="650" Width="1000"
        Style="{StaticResource ModernWindowStyle}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- Boolean to Visibility Converter (Simple Trigger version is used in content, but we define static brushes if needed) -->
    </Window.Resources>

    <Border CornerRadius="12" Background="{StaticResource BackgroundBrush}" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Title Bar -->
                <RowDefinition Height="45" />
                <!-- Main Content -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Border Grid.Row="0" Background="#080611" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Application Title & Icon -->
                    <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center" Margin="16,0,0,0">
                        <!-- Custom Logo Drawing -->
                        <Canvas Width="20" Height="20" Margin="0,0,10,0">
                            <Ellipse Width="20" Height="20" Fill="{StaticResource AccentGradientBrush}" />
                            <Path Data="M 6,10 L 10,14 L 14,6" Stroke="White" StrokeThickness="2" Canvas.Left="0" Canvas.Top="0" />
                        </Canvas>
                        <TextBlock Text="BimboClub Tools" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        <Border Margin="8,0,0,0" Padding="6,2" CornerRadius="4" Background="#1D153E" VerticalAlignment="Center">
                            <TextBlock Text="Менеджер обновлений" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                        </Border>
                    </StackPanel>

                    <!-- Windows Window Controls -->
                    <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Button Width="30" Height="30" Content="—" Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}" BorderThickness="0" Cursor="Hand" Click="MinimizeButton_Click" Margin="0,0,4,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="btnBorder" Background="Transparent" CornerRadius="15">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="btnBorder" Property="Background" Value="#1C1835" />
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Width="30" Height="30" Content="✕" Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}" BorderThickness="0" Cursor="Hand" Click="CloseButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="btnBorder" Background="Transparent" CornerRadius="15">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource DangerBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Application Body -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <!-- Sidebar Navigation -->
                    <ColumnDefinition Width="200" />
                    <!-- Tab Panel Content -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0" Background="{StaticResource SidebarBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Menu Items -->
                        <StackPanel Grid.Row="0" Margin="0,20,0,0">
                            <!-- Plugins Tab Toggle Button -->
                            <RadioButton Style="{StaticResource SidebarButtonStyle}" 
                                         GroupName="SidebarMenu" 
                                         IsChecked="{Binding IsPluginsTabActive, Mode=OneWay}"
                                         Command="{Binding NavigateCommand}" 
                                         CommandParameter="plugins">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M0,0 L12,0 L12,4 L0,4 Z M0,6 L12,6 L12,10 L0,10 Z M0,12 L12,12 L12,16 L0,16 Z" 
                                          Fill="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" 
                                          Width="14" Height="14" Margin="0,0,12,0" Stretch="Fill" />
                                    <TextBlock Text="Плагины" FontWeight="SemiBold" FontSize="14" />
                                </StackPanel>
                            </RadioButton>

                            <!-- Settings Tab Toggle Button -->
                            <RadioButton Style="{StaticResource SidebarButtonStyle}" 
                                         GroupName="SidebarMenu" 
                                         IsChecked="{Binding IsSettingsTabActive, Mode=OneWay}"
                                         Command="{Binding NavigateCommand}" 
                                         CommandParameter="settings">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M10,0 C12,0 14,2 14,4 C14,6 12,8 10,8 C8,8 6,6 6,4 C6,2 8,0 10,0 Z M10,12 C14,12 18,15 18,18 L18,20 L2,20 L2,18 C2,15 6,12 10,12 Z" 
                                          Fill="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" 
                                          Width="14" Height="14" Margin="0,0,12,0" Stretch="Fill" />
                                    <TextBlock Text="Настройки" FontWeight="SemiBold" FontSize="14" />
                                </StackPanel>
                            </RadioButton>

                            <!-- About Tab Toggle Button -->
                            <RadioButton Style="{StaticResource SidebarButtonStyle}" 
                                         GroupName="SidebarMenu" 
                                         IsChecked="{Binding IsAboutTabActive, Mode=OneWay}"
                                         Command="{Binding NavigateCommand}" 
                                         CommandParameter="about">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M10,20 C4.5,20 0,15.5 0,10 C0,4.5 4.5,0 10,0 C15.5,0 20,4.5 20,10 C20,15.5 15.5,20 10,20 Z M9,5 L9,7 L11,7 L11,5 L9,5 Z M9,9 L9,15 L11,15 L11,9 L9,9 Z" 
                                          Fill="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" 
                                          Width="14" Height="14" Margin="0,0,12,0" Stretch="Fill" />
                                    <TextBlock Text="О программе" FontWeight="SemiBold" FontSize="14" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <!-- Sidebar Footer Info -->
                        <StackPanel Grid.Row="1" Margin="16,0,16,16" Opacity="0.5">
                            <TextBlock Text="BimboClub Client" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="v1.0.0" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Page Content Area -->
                <Grid Grid.Column="1" Margin="24">
                    
                    <!-- TAB 1: PLUGINS -->
                    <Grid x:Name="PluginsTab">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentTab}" Value="plugins">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3.5*" />
                            <ColumnDefinition Width="2.5*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Column: Revit Version Status Cards -->
                        <Grid Grid.Column="0" Margin="0,0,16,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Установленные версии Revit" Style="{StaticResource HeadingStyle}" Margin="0,0,0,16" Grid.Row="0" />

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding RevitVersions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:RevitVersionInfo}">
                                            <Border Style="{StaticResource CardStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Revit Icon Badge -->
                                                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8" Margin="0,0,16,0">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#251E3D" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsRevitInstalled}" Value="False">
                                                                        <Setter Property="Background" Value="#171220" />
                                                                        <Setter Property="Opacity" Value="0.4" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsUpdateAvailable}" Value="True">
                                                                        <Setter Property="Background" Value="#3D291E" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        
                                                        <Grid>
                                                            <!-- stylized Revit logo 'R' drawing -->
                                                            <TextBlock Text="R" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsRevitInstalled}" Value="False">
                                                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsUpdateAvailable}" Value="True">
                                                                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Details -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="14">
                                                            <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsRevitInstalled}" Value="False">
                                                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        
                                                        <!-- Status badge -->
                                                        <TextBlock Text="{Binding StatusDescription}" FontSize="12" Margin="0,2,0,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsUpdateAvailable}" Value="True">
                                                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsPluginInstalled}" Value="True">
                                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsRevitInstalled}" Value="False">
                                                                            <Setter Property="Foreground" Value="#5C566E" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <!-- Action buttons -->
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        
                                                        <!-- Install Button -->
                                                        <Button Content="Установить" 
                                                                Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" 
                                                                Height="32" FontSize="12">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding IsRevitInstalled}" Value="True" />
                                                                                <Condition Binding="{Binding IsPluginInstalled}" Value="False" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>

                                                        <!-- Update Button -->
                                                        <Button Content="Обновить" 
                                                                Background="{StaticResource WarningGradientBrush}"
                                                                Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" 
                                                                Height="32" FontSize="12" Margin="0,0,8,0">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding IsRevitInstalled}" Value="True" />
                                                                                <Condition Binding="{Binding IsUpdateAvailable}" Value="True" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>

                                                        <!-- Delete Button -->
                                                        <Button Content="Удалить" 
                                                                Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" 
                                                                Height="32" FontSize="12">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource DangerButtonStyle}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding IsRevitInstalled}" Value="True" />
                                                                                <Condition Binding="{Binding IsPluginInstalled}" Value="True" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>

                                                        <!-- Not installed placeholder label -->
                                                        <TextBlock Text="—" 
                                                                   Foreground="#3A344E" 
                                                                   FontWeight="Bold" 
                                                                   VerticalAlignment="Center" 
                                                                   Margin="10,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsRevitInstalled}" Value="False">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <!-- Right Column: Update center & logs -->
                        <Grid Grid.Column="1" Margin="8,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Центр обновлений" Style="{StaticResource HeadingStyle}" Margin="0,0,0,16" Grid.Row="0" />

                            <Border Style="{StaticResource CardStyle}" Grid.Row="1" VerticalAlignment="Stretch">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Version block -->
                                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                                        <TextBlock Text="ПОСЛЕДНЯЯ ДОСТУПНАЯ ВЕРСИЯ" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding LatestVersion}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,4,0,0" />
                                    </StackPanel>

                                    <!-- Changelog scroll -->
                                    <Grid Grid.Row="1">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="СПИСОК ИЗМЕНЕНИЙ" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" Grid.Row="0" />
                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                            <TextBlock Text="{Binding Changelog}" 
                                                       TextWrapping="Wrap" 
                                                       FontSize="12" 
                                                       Foreground="{StaticResource TextSecondaryBrush}" 
                                                       LineHeight="18" />
                                        </ScrollViewer>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Button Content="Проверить обновления" 
                                    Style="{StaticResource ModernButtonStyle}" 
                                    Command="{Binding CheckUpdatesCommand}"
                                    Grid.Row="2" 
                                    Height="40" 
                                    Margin="0,16,0,0" />
                        </Grid>
                    </Grid>

                    <!-- TAB 2: SETTINGS -->
                    <Grid x:Name="SettingsTab">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentTab}" Value="settings">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Настройки менеджера" Style="{StaticResource HeadingStyle}" Margin="0,0,0,24" Grid.Row="0" />

                        <StackPanel Grid.Row="1">
                            <!-- Update path option -->
                            <TextBlock Text="ИСТОЧНИК ОБНОВЛЕНИЙ" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" />
                            <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding UpdateSource, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" />
                            <TextBlock Text="URL адрес сервера или путь к локальной папке, где размещается update_manifest.json и zip-архивы." 
                                       FontSize="11" Foreground="#5C566E" Margin="0,0,0,24" />

                            <!-- Auto close option -->
                            <CheckBox Style="{StaticResource ModernCheckBoxStyle}" IsChecked="{Binding AutoCloseRevit}" Margin="0,0,0,6">
                                <TextBlock Text="Автоматически закрывать Revit при установке" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                            </CheckBox>
                            <TextBlock Text="Позволяет менеджеру автоматически закрывать все открытые процессы Revit.exe перед обновлением плагина, чтобы избежать блокировки DLL." 
                                       FontSize="11" Foreground="#5C566E" Margin="26,0,0,0" />
                        </StackPanel>

                        <!-- Save button -->
                        <Button Content="Сохранить настройки" 
                                Style="{StaticResource ModernButtonStyle}" 
                                Command="{Binding SaveSettingsCommand}"
                                Grid.Row="2" 
                                Height="40" 
                                Width="200" 
                                HorizontalAlignment="Right" />
                    </Grid>

                    <!-- TAB 3: ABOUT -->
                    <Grid x:Name="AboutTab">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentTab}" Value="about">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource CardStyle}" VerticalAlignment="Center" HorizontalAlignment="Center" Width="550" Padding="32">
                            <StackPanel HorizontalAlignment="Center">
                                <!-- Big stylized logo -->
                                <Border Width="80" Height="80" CornerRadius="40" Background="{StaticResource AccentGradientBrush}" HorizontalAlignment="Center" Margin="0,0,0,24">
                                    <TextBlock Text="B" FontWeight="Bold" FontSize="44" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,4" />
                                </Border>

                                <TextBlock Text="BimboClub Tools" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="Версия 1.0.0" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,16" />

                                <TextBlock Text="Интеллектуальные плагины для автоматизации MEP проектирования в Autodesk Revit." 
                                           FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextAlignment="Center" Width="400" LineHeight="20" HorizontalAlignment="Center" Margin="0,0,0,24" />

                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Разработчик: BimboClub Dev Team" FontSize="11" Foreground="#5C566E" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                        <TextBlock Text="Поддерживаемые версии Revit: 2021 – 2026" FontSize="11" Foreground="#5C566E" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Dialog Overlay: Revit Warning -->
            <Grid Grid.RowSpan="2" Background="#D5000000" Visibility="Collapsed">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowRevitWarning}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Border Style="{StaticResource CardStyle}" Width="450" Height="220" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" Background="#181330">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock Text="⚠" FontSize="22" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="Обнаружен работающий Revit" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="Приложение Autodesk Revit сейчас запущено на вашем компьютере. Для предотвращения блокировки и повреждения DLL-файлов плагина необходимо закрыть Revit перед установкой." 
                                   TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="18" Grid.Row="1" />

                        <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button Content="Отмена" Style="{StaticResource OutlineButtonStyle}" Command="{Binding CloseWarningCommand}" Margin="0,0,12,0" Width="90" Height="34" />
                            <Button Content="Закрыть Revit и продолжить" Style="{StaticResource ModernButtonStyle}" Command="{Binding ForceInstallCommand}" Height="34" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Global Loading overlay -->
            <Grid Grid.RowSpan="2" Background="#90000000">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Border CornerRadius="12" Background="#C50D0A1C" Width="360" Height="140" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
                        <TextBlock Text="{Binding ProgressText}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,16" />
                        
                        <!-- Custom styled progress bar -->
                        <Grid Height="8">
                            <Border CornerRadius="4" Background="#1D153E" />
                            <!-- Glow progress bar -->
                            <ProgressBar Value="{Binding GlobalProgress}" Minimum="0" Maximum="100" BorderThickness="0" Height="8" Background="Transparent" Foreground="{StaticResource AccentGradientBrush}">
                                <ProgressBar.Template>
                                    <ControlTemplate TargetType="ProgressBar">
                                        <Grid x:Name="TemplateRoot">
                                            <Border CornerRadius="4" Background="{TemplateBinding Background}"/>
                                            <Border x:Name="PART_Indicator" CornerRadius="4" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}"/>
                                        </Grid>
                                    </ControlTemplate>
                                </ProgressBar.Template>
                            </ProgressBar>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
