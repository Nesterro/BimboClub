<Window x:Class="BimboClub.ExtraScheduleItems.ExtraScheduleItemsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="⚫ BimboClub | Дополнительные элементы в спецификацию" 
        Height="800" Width="1350"
        MinHeight="650" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Background="#181824"
        FontFamily="Segoe UI"
        FontSize="13"
        Foreground="#E2E2EB"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <!-- Brushes -->
        <SolidColorBrush x:Key="BgDarkBrush" Color="#181824"/>
        <SolidColorBrush x:Key="PanelDarkBrush" Color="#222232"/>
        <SolidColorBrush x:Key="PanelSubtleBrush" Color="#2A2A3E"/>
        <SolidColorBrush x:Key="BorderDarkBrush" Color="#38384E"/>
        <SolidColorBrush x:Key="TextWhiteBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#9A9AB2"/>
        <SolidColorBrush x:Key="AccentScarletBrush" Color="#D32F2F"/>
        <SolidColorBrush x:Key="AccentScarletHoverBrush" Color="#B71C1C"/>
        <SolidColorBrush x:Key="AccentGreenBrush" Color="#2E7D32"/>
        <SolidColorBrush x:Key="AccentGreenHoverBrush" Color="#1B5E20"/>
        <SolidColorBrush x:Key="AccentBlueBrush" Color="#1976D2"/>

        <!-- Primary Green Apply Button -->
        <Style x:Key="ApplyButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentGreenBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentGreenHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PanelSubtleBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextWhiteBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderDarkBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#35354F"/>
                    <Setter Property="BorderBrush" Value="#4F4F72"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Danger Button Style -->
        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3D1A22"/>
            <Setter Property="Foreground" Value="#FF6B81"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#662233"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#5E202E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Dark TextBox (Explicit) -->
        <Style x:Key="DarkTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource PanelDarkBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextWhiteBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderDarkBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Default Dark TextBox for DataGrid cell editing and inputs -->
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="{StaticResource PanelDarkBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextWhiteBrush}"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderDarkBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentScarletBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ComboBoxItem Style -->
        <Style x:Key="DarkComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#222232"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderThickness="0" CornerRadius="4" Margin="2,1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#383855"/>
                                <Setter Property="Foreground" Value="#FFD700"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#B30E2D"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ToggleButton for ComboBox -->
        <ControlTemplate x:Key="DarkComboBoxToggleButtonTemplate" TargetType="ToggleButton">
            <Grid>
                <Border x:Name="Border" 
                        Background="{TemplateBinding Background}" 
                        BorderBrush="{TemplateBinding BorderBrush}" 
                        BorderThickness="{TemplateBinding BorderThickness}" 
                        CornerRadius="5"/>
                <Path x:Name="Arrow" 
                      Data="M 0 0 L 4 4 L 8 0 Z" 
                      Fill="#C8C8DC" 
                      HorizontalAlignment="Right" 
                      VerticalAlignment="Center" 
                      Margin="0,0,10,0"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="#35354F"/>
                    <Setter TargetName="Border" Property="BorderBrush" Value="#525270"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="#2C2C40"/>
                    <Setter TargetName="Border" Property="BorderBrush" Value="#B30E2D"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="#FFFFFF"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Dark ComboBox Style -->
        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource PanelSubtleBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderDarkBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="10,4,24,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" 
                                          Template="{StaticResource DarkComboBoxToggleButtonTemplate}" 
                                          Background="{TemplateBinding Background}" 
                                          BorderBrush="{TemplateBinding BorderBrush}" 
                                          BorderThickness="{TemplateBinding BorderThickness}" 
                                          Focusable="False" 
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter x:Name="ContentSite" 
                                              IsHitTestVisible="False" 
                                              Content="{TemplateBinding SelectionBoxItem}" 
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
                                              Margin="{TemplateBinding Padding}" 
                                              VerticalAlignment="Center" 
                                              HorizontalAlignment="Left">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                            <Popup x:Name="PART_Popup" 
                                   IsOpen="{TemplateBinding IsDropDownOpen}" 
                                   AllowsTransparency="True" 
                                   Focusable="False" 
                                   PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder" 
                                        Background="#1E1E2C" 
                                        BorderBrush="{StaticResource BorderDarkBrush}" 
                                        BorderThickness="1" 
                                        CornerRadius="5" 
                                        Margin="0,2,0,0" 
                                        MinWidth="{TemplateBinding ActualWidth}" 
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer SnapsToDevicePixels="True" CanContentScroll="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="50"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#525270"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid Style -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource PanelDarkBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextWhiteBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderDarkBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="#1E1E2C"/>
            <Setter Property="AlternatingRowBackground" Value="#252538"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#2E2E42"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="ColumnHeaderHeight" Value="34"/>
            <Setter Property="RowHeight" Value="30"/>
        </Style>

        <!-- Column Header Gripper Style for Resizing -->
        <Style x:Key="ColumnHeaderGripperStyle" TargetType="{x:Type Thumb}">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="SizeWE"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGridColumnHeader Style with high contrast active/hover/sorted states and column resizing -->
        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="{StaticResource PanelSubtleBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextWhiteBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderDarkBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type DataGridColumnHeader}">
                        <Grid>
                            <Border x:Name="HeaderBorder" 
                                    Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter x:Name="HeaderContent"
                                                      Grid.Column="0"
                                                      VerticalAlignment="Center" 
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                                      RecognizesAccessKey="True">
                                        <ContentPresenter.Resources>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </Style>
                                        </ContentPresenter.Resources>
                                    </ContentPresenter>
                                    <Path x:Name="SortArrow"
                                          Grid.Column="1"
                                          Margin="6,0,2,0"
                                          VerticalAlignment="Center"
                                          Fill="{StaticResource AccentScarletBrush}"
                                          Visibility="Collapsed"/>
                                </Grid>
                            </Border>

                            <Thumb x:Name="PART_LeftHeaderGripper" 
                                   HorizontalAlignment="Left" 
                                   Style="{StaticResource ColumnHeaderGripperStyle}"/>
                            <Thumb x:Name="PART_RightHeaderGripper" 
                                   HorizontalAlignment="Right" 
                                   Style="{StaticResource ColumnHeaderGripperStyle}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="#383852"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="#4A1825"/>
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Ascending">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="#361D28"/>
                                <Setter TargetName="HeaderBorder" Property="BorderThickness" Value="0,0,1,2"/>
                                <Setter TargetName="HeaderBorder" Property="BorderBrush" Value="{StaticResource AccentScarletBrush}"/>
                                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="SortArrow" Property="Data" Value="M 0 4 L 4 0 L 8 4 Z"/>
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Descending">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="#361D28"/>
                                <Setter TargetName="HeaderBorder" Property="BorderThickness" Value="0,0,1,2"/>
                                <Setter TargetName="HeaderBorder" Property="BorderBrush" Value="{StaticResource AccentScarletBrush}"/>
                                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="SortArrow" Property="Data" Value="M 0 0 L 4 4 L 8 0 Z"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="SortDirection" Value="Ascending"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="HeaderBorder" Property="Background" Value="#452332"/>
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="SortDirection" Value="Descending"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="HeaderBorder" Property="Background" Value="#452332"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGridRow Style with dark selection and hover -->
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#1E1E2C"/>
            <Setter Property="Foreground" Value="{StaticResource TextWhiteBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#3E3E66"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2D2D44"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DataGridCell Style -->
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border x:Name="CellBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="CellBorder" Property="Background" Value="#3E3E66"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Recursive TreeViewItem Style for Category Headers and Leaf Items -->
        <Style TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="True"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition MinWidth="19" Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            
                            <ToggleButton x:Name="Expander" 
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" 
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Width="16" Height="16" Background="Transparent" Padding="4">
                                            <Path x:Name="ExpandPath" Fill="#8A8AA5" Data="M 0 0 L 0 8 L 5 4 Z"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ExpandPath" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="90" CenterX="2.5" CenterY="4"/>
                                                    </Setter.Value>
                                                </Setter>
                                                <Setter TargetName="ExpandPath" Property="Fill" Value="#FFFFFF"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ExpandPath" Property="Fill" Value="#FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Border x:Name="Bd" 
                                    Grid.Column="1" 
                                    Grid.ColumnSpan="2" 
                                    Background="Transparent" 
                                    CornerRadius="4" 
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter x:Name="PART_Header" 
                                                  ContentSource="Header" 
                                                  HorizontalAlignment="Left" 
                                                  VerticalAlignment="Center">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </Border>

                            <ItemsPresenter x:Name="ItemsHost" 
                                            Grid.Row="1" 
                                            Grid.Column="1" 
                                            Grid.ColumnSpan="2"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#B30E2D"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="Selector.IsSelectionActive" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#3E2A35"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#2A2A3E"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <!-- 0: Header -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Filter & Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Main Body (Catalog Drawer + DataGrid) -->
            <RowDefinition Height="*"/>
            <!-- 3: Footer Action Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 0: Header -->
        <Border Grid.Row="0" Background="{StaticResource PanelDarkBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="15,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚫" FontSize="18" Foreground="{StaticResource AccentScarletBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="BimboClub | Дополнительные элементы в спецификацию" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextWhiteBrush}" VerticalAlignment="Center"/>
                        <Border Background="#2E7D32" CornerRadius="4" Padding="6,2" Margin="12,0,0,0">
                            <TextBlock Text="ADSK" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="DocInfoTextBlock" Text="Документ: Загрузка..." FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="26,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource PanelSubtleBrush}" CornerRadius="6" Padding="12,6" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Всего позиций: " Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock x:Name="TotalItemsCountText" Text="0" FontWeight="Bold" Foreground="{StaticResource TextWhiteBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource PanelSubtleBrush}" CornerRadius="6" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="В модели Revit: " Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock x:Name="InModelCountText" Text="0" FontWeight="Bold" Foreground="#4CAF50"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 1: Filter & Action Toolbar -->
        <Border Grid.Row="1" Background="{StaticResource PanelDarkBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Search & Section filter -->
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <!-- Action buttons -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search box -->
                <TextBox x:Name="SearchTextBox" Grid.Column="0" Style="{StaticResource DarkTextBoxStyle}" Margin="0,0,8,0"
                         Text="Поиск по наименованию / марке..." Foreground="{StaticResource TextMutedBrush}"
                         GotFocus="SearchTextBox_GotFocus" LostFocus="SearchTextBox_LostFocus" TextChanged="SearchTextBox_TextChanged"/>

                <!-- Section ComboBox -->
                <ComboBox x:Name="SectionFilterComboBox" Grid.Column="1" Style="{StaticResource DarkComboBoxStyle}" Margin="0,0,8,0"
                          SelectionChanged="SectionFilterComboBox_SelectionChanged"/>

                <Button Content="Сбросить фильтры" Style="{StaticResource SecondaryButtonStyle}" Grid.Column="2" Margin="0,0,12,0" Click="ResetFilters_Click"/>

                <!-- Default Category for new items -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="Категория:" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,6,0" FontSize="12"/>
                    <ComboBox x:Name="DefaultCategoryComboBox" Width="180" Style="{StaticResource DarkComboBoxStyle}"
                              ToolTip="Категория Revit по умолчанию для создаваемых элементов"/>
                </StackPanel>

                <!-- Right Table Actions -->
                <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="➕ Новая строка" Style="{StaticResource SecondaryButtonStyle}" Click="AddRow_Click"/>
                    <Button Content="📋 Дублировать" Style="{StaticResource SecondaryButtonStyle}" Click="DuplicateRow_Click"/>
                    <Button Content="🗑️ Удалить" Style="{StaticResource DangerButtonStyle}" Click="DeleteRow_Click"/>
                    <Border Width="1" Background="{StaticResource BorderDarkBrush}" Margin="6,3"/>
                    <Button Content="📥 Из Excel" Style="{StaticResource SecondaryButtonStyle}" ToolTip="Импорт строк из буфера обмена (скопированных из Excel)" Click="ImportClipboard_Click"/>
                    <Button Content="📤 В Excel" Style="{StaticResource SecondaryButtonStyle}" ToolTip="Экспорт таблицы в Excel / CSV" Click="ExportExcel_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2: Main Body -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <!-- Catalog Drawer (Left) -->
                <ColumnDefinition x:Name="CatalogColumn" Width="330" MinWidth="240" MaxWidth="500"/>
                <ColumnDefinition Width="8"/>
                <!-- Main Schedule DataGrid (Right) -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Catalog Panel -->
            <Border Grid.Column="0" Background="{StaticResource PanelDarkBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="📚 БИБЛИОТЕКА РАСХОДНИКОВ" FontWeight="Bold" FontSize="12" Foreground="{StaticResource AccentScarletBrush}" Margin="4,0,0,8"/>

                    <!-- Search Catalog -->
                    <TextBox x:Name="CatalogSearchBox" Grid.Row="1" Style="{StaticResource DarkTextBoxStyle}" Margin="0,0,0,8"
                             Text="Поиск в библиотеке..." Foreground="{StaticResource TextMutedBrush}"
                             GotFocus="CatalogSearchBox_GotFocus" LostFocus="CatalogSearchBox_LostFocus" TextChanged="CatalogSearchBox_TextChanged"/>

                    <!-- Categories Tree / List -->
                    <TreeView x:Name="CatalogTreeView" Grid.Row="2" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextWhiteBrush}"/>

                    <!-- Catalog Bottom Buttons -->
                    <Grid Grid.Row="3" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="➕ Добавить в проект" Style="{StaticResource SecondaryButtonStyle}" Grid.Column="0" Margin="0,0,6,0" Click="AddCatalogItemToSchedule_Click"/>
                        <Button Content="⭐ В избранное" Style="{StaticResource SecondaryButtonStyle}" Grid.Column="1" ToolTip="Сохранить выбранную позицию из таблицы в библиотеку" Click="SaveCurrentToCatalog_Click"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- Schedule Items Table -->
            <Border Grid.Column="2" Background="{StaticResource PanelDarkBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="0">
                <DataGrid x:Name="ScheduleDataGrid" CellEditEnding="ScheduleDataGrid_CellEditEnding">
                    <DataGrid.Columns>
                        <!-- Section / Group -->
                        <DataGridTextColumn Header="Раздел (Групп.)" Binding="{Binding Group, UpdateSourceTrigger=PropertyChanged}" Width="110"/>

                        <!-- Revit Category -->
                        <DataGridTemplateColumn Header="Категория Revit" Width="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CategoryName}" Foreground="{StaticResource TextWhiteBrush}" VerticalAlignment="Center" Margin="6,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox SelectedItem="{Binding CategoryName, UpdateSourceTrigger=PropertyChanged}"
                                              ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=AvailableCategories}"
                                              Style="{StaticResource DarkComboBoxStyle}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <!-- Position -->
                        <DataGridTextColumn Header="Поз." Binding="{Binding Position, UpdateSourceTrigger=PropertyChanged}" Width="55"/>

                        <!-- Name -->
                        <DataGridTextColumn Header="Наименование (ADSK_Наименование)" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/>

                        <!-- Mark -->
                        <DataGridTextColumn Header="Марка / Обозначение" Binding="{Binding Mark, UpdateSourceTrigger=PropertyChanged}" Width="140"/>

                        <!-- Code -->
                        <DataGridTextColumn Header="Код изделия" Binding="{Binding Code, UpdateSourceTrigger=PropertyChanged}" Width="100"/>

                        <!-- Manufacturer -->
                        <DataGridTextColumn Header="Завод-изготовитель" Binding="{Binding Manufacturer, UpdateSourceTrigger=PropertyChanged}" Width="130"/>

                        <!-- Unit -->
                        <DataGridTextColumn Header="Ед." Binding="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" Width="55"/>

                        <!-- Count -->
                        <DataGridTextColumn Header="Кол-во" Binding="{Binding Count, StringFormat={}{0:0.##}, UpdateSourceTrigger=PropertyChanged}" Width="70"/>

                        <!-- Weight -->
                        <DataGridTextColumn Header="Масса, кг" Binding="{Binding Weight, StringFormat={}{0:0.###}, UpdateSourceTrigger=PropertyChanged}" Width="75"/>

                        <!-- Note -->
                        <DataGridTextColumn Header="Примечание" Binding="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Width="130"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- 3: Footer Action Bar -->
        <Border Grid.Row="3" Background="{StaticResource PanelDarkBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusMessageTextBlock" Text="Готово к работе" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Закрыть" Style="{StaticResource SecondaryButtonStyle}" Width="100" Margin="0,0,10,0" Click="CloseButton_Click"/>
                    <Button Content="💾 Применить в Revit" Style="{StaticResource ApplyButtonStyle}" Click="ApplyToRevit_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
