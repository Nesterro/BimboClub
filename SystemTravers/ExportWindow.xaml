<Window x:Class="BimboClub.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="⚫ BimboClub | Экспорт в PDF" 
        Height="840" Width="620"
        MinHeight="650" MinWidth="540"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E"
        FontFamily="Segoe UI"
        FontSize="13"
        Foreground="#FFFFFF"
        ResizeMode="CanResizeWithGrip">
    
    <Window.Resources>
        <!-- WPF Converter -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Primary Button Style (Gold background, dark bold text) -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFD700"/>
            <Setter Property="Foreground" Value="#121020"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFE44D"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#3F3F56"/>
                    <Setter Property="Foreground" Value="#888888"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#252536"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#4F4F6E"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#35354A"/>
                    <Setter Property="BorderBrush" Value="#FFD700"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Custom TextBox Style -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#181824"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#4F4F6E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#FFD700"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom ListBox Style -->
        <Style x:Key="ModernListBoxStyle" TargetType="ListBox">
            <Setter Property="BorderBrush" Value="#3F3F56"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#181824"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Background="{TemplateBinding Background}">
                            <ScrollViewer Focusable="false" Padding="{TemplateBinding Padding}">
                                <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#181824"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#4F4F6E"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- Title Header (Row 0) -->
            <RowDefinition Height="Auto"/>
            <!-- Sheet Set Selection (Row 1) -->
            <RowDefinition Height="Auto"/>
            <!-- Search Filter (Row 2) -->
            <RowDefinition Height="Auto"/>
            <!-- Sheet List (Row 3) -->
            <RowDefinition Height="*"/>
            <!-- Select All/None Actions (Row 4) -->
            <RowDefinition Height="Auto"/>
            <!-- Advanced Print Options (Row 5) -->
            <RowDefinition Height="Auto"/>
            <!-- Action Buttons (Row 6) -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Header -->
        <Border Grid.Row="0" BorderBrush="#3F3F56" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="BimboClub" Foreground="#FFD700" FontWeight="Bold" FontSize="18"/>
                <TextBlock Text=" | ЭКСПОРТ В PDF" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="18" Margin="5,0,0,0"/>
                <TextBlock x:Name="SelectedCountText" Text=" (выбрано: 0 из 0)" Foreground="#00E5FF" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Sheet Set & Printer Selection -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Набор листов:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#D0D0E0" Margin="0,0,8,0"/>
            <ComboBox Grid.Column="1" x:Name="SheetSetComboBox" SelectionChanged="SheetSetComboBox_SelectionChanged" Margin="0,0,12,0"/>

            <TextBlock Grid.Column="2" Text="Принтер / Движок:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#D0D0E0" Margin="0,0,8,0"/>
            <ComboBox Grid.Column="3" x:Name="PrinterComboBox"/>
        </Grid>

        <!-- Search Box -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <TextBox x:Name="SearchTextBox" 
                     Style="{StaticResource ModernTextBoxStyle}" 
                     TextChanged="SearchTextBox_TextChanged"/>
            <!-- Watermark Text -->
            <TextBlock Text="🔍 Поиск по номеру или имени листа..." 
                       Foreground="#7F7F98" 
                       IsHitTestVisible="False" 
                       VerticalAlignment="Center" 
                       Margin="10,0,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}" Value="">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <!-- Sheet List with Checkboxes -->
        <ListBox Grid.Row="3" 
                 x:Name="SheetsListBox" 
                 Style="{StaticResource ModernListBoxStyle}"
                 SelectionMode="Multiple"
                 Margin="0,0,0,8">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="6,4"/>
                    <Setter Property="Margin" Value="0,1"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background" Value="#2A2A3D"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Click="CheckBox_Click" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayName}" FontSize="13" Foreground="#FFFFFF" Margin="6,0,0,0"/>
                    </CheckBox>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Select All / Select None Quick Actions -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Выбрать все" Style="{StaticResource SecondaryButtonStyle}" Click="SelectAll_Click" Margin="0,0,8,0"/>
            <Button Content="Снять выделение" Style="{StaticResource SecondaryButtonStyle}" Click="SelectNone_Click"/>
        </StackPanel>

        <!-- Advanced Options Grid -->
        <Border Grid.Row="5" Background="#252536" BorderBrush="#3F3F56" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="НАСТРОЙКИ ПЕЧАТИ И ЭКСПОРТА" FontWeight="Bold" FontSize="11" Foreground="#FFD700" Margin="0,0,0,8"/>
                
                <!-- Output Folder Selection -->
                <TextBlock Text="Папка сохранения:" FontWeight="SemiBold" Foreground="#D0D0E0" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="FolderTextBox" Style="{StaticResource ModernTextBoxStyle}" IsReadOnly="True" Margin="0,0,6,0"/>
                    <Button Grid.Column="1" Content="Обзор..." Style="{StaticResource SecondaryButtonStyle}" Click="BrowseFolder_Click" Width="80"/>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" x:Name="CombineCheckBox" Content="Объединить листы в один файл:" IsChecked="True" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox Grid.Column="1" x:Name="FileNameTextBox" Text="BimboClub_Export.pdf" Style="{StaticResource ModernTextBoxStyle}"/>
                </Grid>

                <!-- Hidden Dropdown Options for API compatibility -->
                <Grid Visibility="Collapsed">
                    <ComboBox x:Name="PaperFormatComboBox"><ComboBoxItem Content="Default"/></ComboBox>
                    <ComboBox x:Name="PageOrientationComboBox"><ComboBoxItem Content="Auto"/></ComboBox>
                    <ComboBox x:Name="ColorDepthComboBox"><ComboBoxItem Content="Color"/></ComboBox>
                    <ComboBox x:Name="ZoomTypeComboBox"><ComboBoxItem Content="FitToPage"/></ComboBox>
                    <ComboBox x:Name="ProcessingTypeComboBox"><ComboBoxItem Content="Vector"/></ComboBox>
                </Grid>

                <StackPanel Orientation="Horizontal">
                    <CheckBox x:Name="CropMarginsCheckBox" Content="Убрать поля" IsChecked="True" Margin="0,0,16,0"/>
                    <CheckBox x:Name="FixQuotesCheckBox" Content="Исправить кавычки" IsChecked="True"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Action Buttons -->
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock x:Name="StatusTextBlock" Grid.Column="0" Text="Готов к экспорту" VerticalAlignment="Center" Foreground="#00E5FF" FontWeight="SemiBold"/>
            <Button Grid.Column="1" Content="Отмена" Style="{StaticResource SecondaryButtonStyle}" Click="Cancel_Click" Width="90" Margin="0,0,8,0"/>
            <Button Grid.Column="2" Content="Экспорт PDF" Style="{StaticResource PrimaryButtonStyle}" Click="Export_Click" Width="130"/>
        </Grid>
    </Grid>
</Window>
