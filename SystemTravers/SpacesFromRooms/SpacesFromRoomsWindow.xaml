<Window x:Class="BimboClub.SpacesFromRooms.SpacesFromRoomsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="⚫ BimboClub | Пространства по помещениям АР" 
        Height="560" Width="520"
        MinHeight="500" MinWidth="460"
        WindowStartupLocation="CenterScreen"
        Background="#181824"
        FontFamily="Segoe UI"
        FontSize="13"
        Foreground="#E2E2EB"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <!-- Brushes -->
        <SolidColorBrush x:Key="BgDarkBrush" Color="#181824"/>
        <SolidColorBrush x:Key="PanelDarkBrush" Color="#222232"/>
        <SolidColorBrush x:Key="PanelSubtleBrush" Color="#2A2A3E"/>
        <SolidColorBrush x:Key="BorderDarkBrush" Color="#38384E"/>
        <SolidColorBrush x:Key="TextWhiteBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#9A9AB2"/>
        <SolidColorBrush x:Key="AccentScarletBrush" Color="#D32F2F"/>
        <SolidColorBrush x:Key="AccentGreenBrush" Color="#2E7D32"/>
        <SolidColorBrush x:Key="AccentGreenHoverBrush" Color="#1B5E20"/>

        <!-- Primary Action Button -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentGreenBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentGreenHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PanelSubtleBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextWhiteBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderDarkBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#35354F"/>
                    <Setter Property="BorderBrush" Value="#4F4F72"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Dark ComboBoxItem Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#222232"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderThickness="0" CornerRadius="4" Margin="2,1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#383855"/>
                                <Setter Property="Foreground" Value="#FFD700"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#B30E2D"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource PanelSubtleBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderDarkBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="10,4,24,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Dark CheckBox Style -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextWhiteBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <!-- 0: Header -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Link Selection -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Levels List -->
            <RowDefinition Height="*"/>
            <!-- 3: Options -->
            <RowDefinition Height="Auto"/>
            <!-- 4: Action Buttons -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource PanelDarkBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🏢" FontSize="20" Foreground="{StaticResource AccentScarletBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel>
                    <TextBlock Text="Пространства по помещениям АР" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextWhiteBrush}"/>
                    <TextBlock Text="Автоматическая генерация пространств MEP по помещениям из связи с именами и номерами" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Link Selection -->
        <Border Grid.Row="1" Background="{StaticResource PanelDarkBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Связанный файл архитектуры (АР):" FontWeight="SemiBold" Foreground="{StaticResource TextWhiteBrush}" Margin="0,0,0,6"/>
                <ComboBox x:Name="LinksComboBox" DisplayMemberPath="DisplayName"/>
            </StackPanel>
        </Border>

        <!-- Levels Selection -->
        <Border Grid.Row="2" Background="{StaticResource PanelDarkBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Уровни для расстановки пространств:" FontWeight="SemiBold" Foreground="{StaticResource TextWhiteBrush}" Margin="0,0,0,8"/>

                <Border Grid.Row="1" Background="{StaticResource PanelSubtleBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="6">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="LevelsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="4,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="Выбрать все" Style="{StaticResource SecondaryButtonStyle}" Click="SelectAllLevels_Click" Margin="0,0,6,0"/>
                    <Button Content="Снять все" Style="{StaticResource SecondaryButtonStyle}" Click="DeselectAllLevels_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Options -->
        <Border Grid.Row="3" Background="{StaticResource PanelDarkBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Параметры переноса данных:" FontWeight="SemiBold" Foreground="{StaticResource TextWhiteBrush}" Margin="0,0,0,6"/>
                <CheckBox x:Name="CopyNameAndNumberCheckBox" Content="Копировать имя и номер помещения (SPACE_NAME, SPACE_NUMBER)" IsChecked="True"/>
                <CheckBox x:Name="CopyHeightsCheckBox" Content="Копировать высотные отметки (Upper Limit, Limit Offset, Base Offset)" IsChecked="True"/>
                <CheckBox x:Name="EnableRoomBoundingCheckBox" Content="Включить 'Границу помещения' (Room Bounding) у связи при необходимости" IsChecked="True"/>
                <CheckBox x:Name="UpdateExistingCheckBox" Content="Обновлять имена и номера существующих пространств" IsChecked="True"/>
                <CheckBox x:Name="SkipExistingCheckBox" Content="Пропускать создание, если в точке уже есть пространство" IsChecked="True"/>
            </StackPanel>
        </Border>

        <!-- Action Buttons -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1" Content="Отмена" Style="{StaticResource SecondaryButtonStyle}" Width="90" IsCancel="True" Click="Cancel_Click"/>
            <Button Grid.Column="3" Content="Расставить пространства" Style="{StaticResource PrimaryButtonStyle}" IsDefault="True" Click="Create_Click"/>
        </Grid>
    </Grid>
</Window>
