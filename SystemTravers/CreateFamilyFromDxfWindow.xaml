<Window x:Class="BimboClub.CreateFamilyFromDxfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="⚫ BimboClub | Создание семейства по DXF" 
        Height="420" Width="560"
        MinHeight="380" MinWidth="480"
        WindowStartupLocation="CenterScreen"
        Background="#181824"
        FontFamily="Segoe UI"
        FontSize="13"
        Foreground="#E2E2EB"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Brushes -->
        <SolidColorBrush x:Key="BgDarkBrush" Color="#181824"/>
        <SolidColorBrush x:Key="PanelDarkBrush" Color="#222232"/>
        <SolidColorBrush x:Key="PanelSubtleBrush" Color="#2A2A3E"/>
        <SolidColorBrush x:Key="BorderDarkBrush" Color="#38384E"/>
        <SolidColorBrush x:Key="TextWhiteBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#9A9AB2"/>
        <SolidColorBrush x:Key="AccentScarletBrush" Color="#D32F2F"/>
        <SolidColorBrush x:Key="AccentGreenBrush" Color="#2E7D32"/>
        <SolidColorBrush x:Key="AccentGreenHoverBrush" Color="#1B5E20"/>

        <!-- Primary Action Button -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentGreenBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentGreenHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PanelSubtleBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextWhiteBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderDarkBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#35354F"/>
                    <Setter Property="BorderBrush" Value="#4F4F72"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Dark TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource PanelSubtleBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextWhiteBrush}"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderDarkBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentScarletBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Dark ComboBoxItem Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#222232"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderThickness="0" CornerRadius="4" Margin="2,1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#383855"/>
                                <Setter Property="Foreground" Value="#FFD700"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#B30E2D"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource PanelSubtleBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderDarkBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="10,4,24,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Dark CheckBox Style -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextWhiteBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- 0: Header Banner -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Form Fields -->
            <RowDefinition Height="*"/>
            <!-- 2: Action Buttons -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource PanelDarkBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🎲" FontSize="18" Foreground="{StaticResource AccentScarletBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel>
                    <TextBlock Text="Семейство по DXF" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextWhiteBrush}"/>
                    <TextBlock Text="Импорт 3D-геометрии в шаблон Revit с выбором категории" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Form Body -->
        <Border Grid.Row="1" Background="{StaticResource PanelDarkBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,16">
            <StackPanel>
                <!-- 1. DXF File -->
                <TextBlock Text="Файл чертежа DXF:" FontWeight="SemiBold" Foreground="{StaticResource TextWhiteBrush}" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="DxfPathTextBox" Grid.Column="0" IsReadOnly="True" TextChanged="DxfPathTextBox_TextChanged"/>
                    <Button Grid.Column="2" Content="Обзор..." Style="{StaticResource SecondaryButtonStyle}" Width="80" Click="BrowseDxf_Click"/>
                </Grid>

                <!-- 2. Family Name -->
                <TextBlock Text="Имя создаваемого семейства:" FontWeight="SemiBold" Foreground="{StaticResource TextWhiteBrush}" Margin="0,0,0,6"/>
                <TextBox x:Name="FamilyNameTextBox" Margin="0,0,0,14"/>

                <!-- 3. Category Selection -->
                <TextBlock Text="Категория семейства Revit:" FontWeight="SemiBold" Foreground="{StaticResource TextWhiteBrush}" Margin="0,0,0,6"/>
                <ComboBox x:Name="CategoryComboBox" DisplayMemberPath="DisplayName" Margin="0,0,0,16"/>

                <!-- 4. Auto Place Checkbox -->
                <CheckBox x:Name="AutoPlaceCheckBox" Content="Сразу разместить созданное семейство на виде проекта" IsChecked="True"/>
            </StackPanel>
        </Border>

        <!-- Actions -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1" Content="Отмена" Style="{StaticResource SecondaryButtonStyle}" Width="90" IsCancel="True" Click="Cancel_Click"/>
            <Button Grid.Column="3" Content="Создать семейство" Style="{StaticResource PrimaryButtonStyle}" IsDefault="True" Click="Create_Click"/>
        </Grid>
    </Grid>
</Window>
