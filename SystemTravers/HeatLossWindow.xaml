<Window x:Class="BimboClub.HeatLossWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="⚫ BimboClub | Расчёт теплопотерь" 
        Height="780" Width="550"
        MinHeight="600" MinWidth="480"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E"
        FontFamily="Segoe UI"
        FontSize="13"
        Foreground="#FFFFFF"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFD700"/>
            <Setter Property="Foreground" Value="#121020"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFE44D"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#252536"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#4F4F6E"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#35354A"/>
                    <Setter Property="BorderBrush" Value="#FFD700"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#181824"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#4F4F6E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#FFD700"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#181824"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#4F4F6E"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" BorderBrush="#3F3F56" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="BimboClub" Foreground="#FFD700" FontWeight="Bold" FontSize="18"/>
                <TextBlock Text=" | РАСЧЁТ ТЕПЛОПОТЕРЬ" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="18" Margin="5,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Info banner -->
                <Border Background="#2B2415" BorderBrush="#FFD700" BorderThickness="1"
                        CornerRadius="5" Padding="10,8" Margin="0,0,0,14">
                    <TextBlock x:Name="InfoTextBlock"
                               Text="Найдено помещений: —"
                               Foreground="#FFD700" FontWeight="Bold" FontSize="12.5" TextWrapping="Wrap"/>
                </Border>

                <!-- Scope Area -->
                <Border Background="#252536" BorderBrush="#3F3F56" BorderThickness="1"
                        CornerRadius="6" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Область расстановки:"
                                   FontWeight="Bold" Foreground="#FFD700" Margin="0,0,0,8"/>
                        <RadioButton x:Name="AllSpacesRadioButton" Content="🌐 Во всём проекте"
                                     IsChecked="True" GroupName="ScopeGroup" Margin="0,0,0,6" Checked="Scope_Checked"/>
                        <RadioButton x:Name="ActiveViewRadioButton" Content="👁️ Только на текущем виде"
                                     GroupName="ScopeGroup" Checked="Scope_Checked"/>
                    </StackPanel>
                </Border>

                <!-- Cube Family -->
                <Border Background="#252536" BorderBrush="#3F3F56" BorderThickness="1"
                        CornerRadius="6" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Семейство кубика (Обобщённая модель):"
                                   FontWeight="Bold" Foreground="#FFD700" Margin="0,0,0,6"/>
                        <ComboBox x:Name="FamilyComboBox"/>
                    </StackPanel>
                </Border>

                <!-- Temperatures -->
                <Border Background="#252536" BorderBrush="#3F3F56" BorderThickness="1"
                        CornerRadius="6" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Температурные условия (°C):"
                                   FontWeight="Bold" Foreground="#FFD700" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Наружный воздух:" Foreground="#D0D0E0"
                                           Margin="0,0,0,4" FontSize="12"/>
                                <TextBox x:Name="TempOutsideTextBox"
                                         Style="{StaticResource ModernTextBoxStyle}"
                                         Text="-28"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Внутренний воздух:" Foreground="#D0D0E0"
                                           Margin="0,0,0,4" FontSize="12"/>
                                <TextBox x:Name="TempInsideTextBox"
                                         Style="{StaticResource ModernTextBoxStyle}"
                                         Text="20"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Construction Types -->
                <Border Background="#252536" BorderBrush="#3F3F56" BorderThickness="1"
                        CornerRadius="6" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Обрабатываемые конструкции:"
                                   FontWeight="Bold" Foreground="#FFD700" Margin="0,0,0,10"/>

                        <UniformGrid Columns="2" Rows="3">
                            <CheckBox x:Name="ExteriorWallsCheckBox" Content="🧱  Наружные стены"
                                      IsChecked="True" Margin="0,0,0,8"/>
                            <CheckBox x:Name="InteriorWallsCheckBox" Content="🧱  Внутренние стены"
                                      IsChecked="False" Margin="0,0,0,8"/>
                            <CheckBox x:Name="FloorsCheckBox" Content="⬛  Перекрытия / полы"
                                      IsChecked="True" Margin="0,0,0,8"/>
                            <CheckBox x:Name="DoorsCheckBox" Content="🚪  Двери"
                                      IsChecked="True" Margin="0,0,0,8"/>
                            <CheckBox x:Name="WindowsCheckBox" Content="🪟  Окна"
                                      IsChecked="True"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- Exterior / Interior Detection Settings -->
                <Border Background="#252536" BorderBrush="#3F3F56" BorderThickness="1"
                        CornerRadius="6" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Определение наружных / внутренних конструкций:"
                                   FontWeight="Bold" Foreground="#FFD700" Margin="0,0,0,10"/>

                        <RadioButton x:Name="ExteriorDetectByParamRadioButton" 
                                     Content="🏷️ По параметру элементов (MN_Наружный / АР / КР)"
                                     IsChecked="True" GroupName="ExteriorDetectGroup" Margin="0,0,0,8"
                                     Checked="ExteriorDetect_Checked" Unchecked="ExteriorDetect_Checked"/>

                        <Border x:Name="ExteriorParamSettingsPanel" Background="#181824" BorderBrush="#3F3F56" BorderThickness="1"
                                CornerRadius="5" Padding="10" Margin="0,0,0,8">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Имя параметра:" VerticalAlignment="Center" Foreground="#D0D0E0" FontSize="12"/>
                                    <TextBox Grid.Column="1" x:Name="ExteriorParamNameTextBox" 
                                             Style="{StaticResource ModernTextBoxStyle}" Text="MN_Наружный"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Условие:" VerticalAlignment="Center" Foreground="#D0D0E0" FontSize="12"/>
                                    <ComboBox Grid.Column="1" x:Name="ExteriorParamConditionComboBox" 
                                              SelectionChanged="ExteriorParamCondition_SelectionChanged">
                                        <ComboBoxItem Content="Чекбокс включен (Да / 1)" IsSelected="True"/>
                                        <ComboBoxItem Content="Чекбокс выключен (Нет / 0)"/>
                                        <ComboBoxItem Content="Текст равен значению..."/>
                                        <ComboBoxItem Content="Текст содержит..."/>
                                        <ComboBoxItem Content="Параметр заполнен (не пустой)"/>
                                    </ComboBox>
                                </Grid>

                                <Grid x:Name="ExteriorParamValueRow" Margin="0,0,0,8" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Значение:" VerticalAlignment="Center" Foreground="#D0D0E0" FontSize="12"/>
                                    <TextBox Grid.Column="1" x:Name="ExteriorParamValueTextBox" 
                                             Style="{StaticResource ModernTextBoxStyle}" Text="1"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Классификация:" VerticalAlignment="Center" Foreground="#D0D0E0" FontSize="12"/>
                                    <ComboBox Grid.Column="1" x:Name="ExteriorClassificationComboBox">
                                        <ComboBoxItem Content="Считать НАРУЖНОЙ (если выполнено)" IsSelected="True"/>
                                        <ComboBoxItem Content="Считать ВНУТРЕННЕЙ (если выполнено)"/>
                                    </ComboBox>
                                </Grid>

                                <CheckBox x:Name="ExteriorFallbackCheckBox" 
                                          Content="Если параметр не найден — определять автоматически" 
                                          IsChecked="True" Margin="0,2,0,0" FontSize="12"/>
                            </StackPanel>
                        </Border>

                        <RadioButton x:Name="ExteriorDetectAutoRadioButton" 
                                     Content="⚙️ Автоматически (по свойствам типа Revit и топологии)"
                                     GroupName="ExteriorDetectGroup"
                                     Checked="ExteriorDetect_Checked" Unchecked="ExteriorDetect_Checked"/>
                    </StackPanel>
                </Border>

                <!-- Hint footer -->
                <Border Background="#1A2E20" BorderBrush="#4CAF50" BorderThickness="1"
                        CornerRadius="5" Padding="10,8" Margin="0,0,0,4">
                    <TextBlock Foreground="#81C784" FontSize="12" TextWrapping="Wrap">
                        После расстановки в проекте появятся параметры элементов «BimboClub_HeatLoss_…»
                        и спецификация <Bold>«BimboClub Теплопотери»</Bold>,
                        отсортированная по номеру и имени помещения.
                    </TextBlock>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <Grid Grid.Row="2" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Content="Отмена" Style="{StaticResource SecondaryButtonStyle}"
                    Width="100" HorizontalAlignment="Left" Click="Cancel_Click"/>
            <Button Grid.Column="1" x:Name="RunButton"
                    Content="РАССТАВИТЬ" Style="{StaticResource PrimaryButtonStyle}"
                    Width="160" HorizontalAlignment="Right" Click="Run_Click"/>
        </Grid>
    </Grid>
</Window>
