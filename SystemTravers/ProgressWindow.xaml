<Window x:Class="BimboClub.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="вљ« BimboClub | Прогресс" Height="140" Width="420"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#1E1E2E"
        BorderBrush="#C91414"
        BorderThickness="1.5"
        FontFamily="Segoe UI"
        FontSize="13"
        Foreground="#FFFFFF"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="BimboClub" Foreground="#FFD700" FontWeight="Bold" FontSize="14"/>
            <TextBlock x:Name="HeaderTitleText" Text=" | ВЫПОЛНЕНИЕ ОПЕРАЦИИ" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="14" Margin="5,0,0,0"/>
        </StackPanel>
        
        <!-- Status Label -->
        <TextBlock Grid.Row="1" x:Name="StatusText" Text="Выполнение..." Foreground="#595959" TextTrimming="CharacterEllipsis"/>
        
        <!-- Flat Red Progress Bar -->
        <ProgressBar Grid.Row="2" x:Name="ExportProgressBar" Height="8" Margin="0,12,0,0" 
                     Background="#F0F0F0" Foreground="#FFD700" BorderThickness="0">
            <ProgressBar.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="4"/>
                </Style>
            </ProgressBar.Resources>
        </ProgressBar>
    </Grid>
</Window>
